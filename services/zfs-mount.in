# Import ZFS pools and mount datasets before fstab and local filesystems.
# No start timeout: `zfs mount -l` may prompt for encryption passphrases.

type          = scripted
command       = @LIBDIR@/dinit/zfs-mount
restart       = false
options       = starts-on-console
start-timeout = 0
depends-on    = early-fs-pre.target
after         = early-root-rw.target
before        = early-fs-fstab.target
before        = early-fs-local.target
