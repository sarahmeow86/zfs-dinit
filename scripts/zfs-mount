#!/bin/sh
#
# Import ZFS pools and mount their datasets.
#
# Derived from dinit-chimera early/scripts/fs-zfs.sh
# Copyright 2021-2024 q66 <q66@chimera-linux.org> - BSD-2-Clause
#
# A pool that fails to import or a dataset that fails to mount makes the
# service fail, so `dinitctl status zfs-mount` shows it and the services that
# depend on it (zed, zfs-share, zfs-zvol) do not start on top of it. Having
# nothing to import is not a failure: `zpool import -a` exits 0 then.

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

command -v zfs > /dev/null 2>&1 || exit 0
command -v zpool > /dev/null 2>&1 || exit 0

if [ -r /proc/cmdline ]; then
    for x in $(cat /proc/cmdline); do
        case "$x" in
            dinit_skip_volumes) exit 0 ;;
        esac
    done
fi

status=0

if [ -e /etc/zfs/zpool.cache ]; then
    zpool import -N -a -c /etc/zfs/zpool.cache || status=$?
else
    zpool import -N -a -o cachefile=none || status=$?
fi

zfs mount -a -l || status=$?

exit "$status"
