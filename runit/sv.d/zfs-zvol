#!/bin/bash
#
# runit-rc sysinit step: wait for /dev/zvol links. Only needed when fstab or
# swap reference zvols; enable it with
#   ln -s /usr/lib/rc/sv.d/zfs-zvol /etc/rc/sysinit/58-zfs-zvol

. /usr/lib/rc/functions

case "$1" in
    start)
        stat_busy "Waiting for ZFS volumes"
        zvol_wait || stat_die zfs-zvol
        add_daemon zfs-zvol
        stat_done zfs-zvol
        ;;
    *)
        echo "usage: $0 {start}"
        exit 1
        ;;
esac
