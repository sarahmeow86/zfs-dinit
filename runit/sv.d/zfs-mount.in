#!/bin/bash
#
# runit-rc sysinit step: import ZFS pools and mount their datasets.
# Linked as /etc/rc/sysinit/57-zfs-mount, after 55-remount-root (so
# mountpoints can be created and zpool.cache updated) and before
# 60-mount-all (so fstab entries on ZFS datasets find them mounted).

. /usr/lib/rc/functions

case "$1" in
    start)
        stat_busy "Importing ZFS pools and mounting datasets"
        @LIBDIR@/rc/zfs-mount || stat_die zfs-mount
        add_daemon zfs-mount
        stat_done zfs-mount
        ;;
    *)
        echo "usage: $0 {start}"
        exit 1
        ;;
esac
